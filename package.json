{
  "name": "app-game-store",
  "private": true,
  "version": "0.1.0",
  "description": "Private link-only installer for self-built apps",
  "workspaces": [
    "shared",
    "worker",
    "site"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w site"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
