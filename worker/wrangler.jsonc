{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-game-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "STORE", "id": "REPLACE_WITH_KV_ID" }
  ],
  "vars": {
    // Origin of the static site, used for CORS and redirects after enrolment.
    "SITE_ORIGIN": "https://george-mcintyre.github.io",
    // Path prefix of the site on that origin.
    "SITE_BASE": "/app-game-store/",
    "APPLE_API_BASE": "https://api.appstoreconnect.apple.com",
    "GITHUB_API_BASE": "https://api.github.com"
  },
  "observability": { "enabled": true }
}
